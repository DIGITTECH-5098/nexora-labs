<Window
    x:Class="Nexora.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Nexora.Models"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1F1F24" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderBrush" Value="#2D2D34" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#C7C7CC" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#111214">
            <Grid MaxWidth="1440" Margin="32" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="42" Height="42" CornerRadius="14" Background="#3B82F6">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="N" />
                        </Border>
                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Nexora" />
                            <TextBlock Foreground="#A1A1AA" Text="Windows performance and troubleshooting" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock FontSize="42" FontWeight="Bold" Text="PC Health" />
                    <TextBlock Foreground="#A1A1AA" Text="Live diagnostics with safe recommendations only." />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="20" RowSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Foreground="#A1A1AA" FontSize="16" Text="Overall health score" />
                            <TextBlock FontSize="88" FontWeight="Bold" Text="{Binding HealthScoreText}" />
                            <TextBlock FontSize="18" Foreground="#D4D4D8" Text="{Binding HealthSummary}" />
                            <TextBlock Foreground="#A1A1AA" Text="Starts at 100 and drops when CPU, RAM, or disk pressure is high." TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <Button Height="52" Command="{Binding ScanCommand}" Content="Scan My PC" />
                            <ProgressRing Width="36" Height="36" IsActive="{Binding IsScanning}" />
                            <TextBlock Foreground="#D4D4D8" Text="{Binding ScanStatus}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" x:Name="MetricsGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="WideState">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1100" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="CpuCard.(Grid.Row)" Value="0" />
                                    <Setter Target="CpuCard.(Grid.Column)" Value="0" />
                                    <Setter Target="CpuCard.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="RamCard.(Grid.Row)" Value="0" />
                                    <Setter Target="RamCard.(Grid.Column)" Value="1" />
                                    <Setter Target="RamCard.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="DiskCard.(Grid.Row)" Value="0" />
                                    <Setter Target="DiskCard.(Grid.Column)" Value="2" />
                                    <Setter Target="DiskCard.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="WindowsCard.(Grid.Row)" Value="1" />
                                    <Setter Target="WindowsCard.(Grid.Column)" Value="0" />
                                    <Setter Target="WindowsCard.(Grid.ColumnSpan)" Value="2" />
                                    <Setter Target="UptimeCard.(Grid.Row)" Value="1" />
                                    <Setter Target="UptimeCard.(Grid.Column)" Value="2" />
                                    <Setter Target="UptimeCard.(Grid.ColumnSpan)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border x:Name="CpuCard" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="CPU usage" />
                            <TextBlock Style="{StaticResource CardValueStyle}" Text="{Binding CpuUsageText}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="RamCard" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="RAM usage" />
                            <TextBlock Style="{StaticResource CardValueStyle}" Text="{Binding RamUsageText}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DiskCard" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Disk usage" />
                            <TextBlock Style="{StaticResource CardValueStyle}" Text="{Binding DiskUsageText}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="WindowsCard" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Windows version" />
                            <TextBlock Style="{StaticResource CardValueStyle}" Text="{Binding WindowsVersionText}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="UptimeCard" Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="System uptime" />
                            <TextBlock Style="{StaticResource CardValueStyle}" Text="{Binding UptimeText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Recommendations" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RecommendationItem">
                                    <Border Background="#17181C" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Foreground="#D4D4D8" TextWrapping="WrapWholeWords" Text="{Binding Message}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
